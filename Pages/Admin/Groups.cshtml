@page
@model ElectronicJournal.Pages.Admin.GroupsModel
@{
    ViewData["Title"] = "Управление группами";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-collection-fill"></i> Управление группами</h2>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Форма создания группы -->
    <div class="col-md-4 mb-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Создать группу</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="CreateGroup">
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label">Название группы</label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Year" class="form-label">Год обучения</label>
                        <input asp-for="Input.Year" type="number" class="form-control" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label">Активна</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle"></i> Создать
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Список групп -->
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-list"></i> Список групп</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Название</th>
                                <th>Год</th>
                                <th>Студентов</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.Groups)
                            {
                                <tr>
                                    <td>@group.Name</td>
                                    <td>@group.Year</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @(Model.StudentCounts.ContainsKey(group.Id) ? Model.StudentCounts[group.Id] : 0)
                                        </span>
                                    </td>
                                    <td>
                                        @if (group.IsActive)
                                        {
                                            <span class="badge bg-success">Активна</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Неактивна</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#addStudentsModal"
                                                onclick="setGroupId(@group.Id)">
                                            <i class="bi bi-person-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="deleteGroup(@group.Id, '@group.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно добавления студентов -->
<div class="modal fade" id="addStudentsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить студентов в группу</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="AddStudents">
                <input type="hidden" name="studentInput.groupId" id="modalGroupId" />
                <div class="modal-body">
                    @{
                        var students = ViewData["StudentsWithoutGroup"] as List<ElectronicJournal.Models.Student>;
                    }
                    @if (students != null && students.Any())
                    {
                        @foreach (var student in students)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="studentInput.selectedStudents" value="@student.UserId" />
                                <label class="form-check-label">
                                    @student.User?.FullName (@student.User?.Email)
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Нет студентов без группы</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                    <button type="submit" class="btn btn-primary">Добавить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Формы для удаления групп -->
@foreach (var group in Model.Groups)
{
    <form method="post" asp-page-handler="DeleteGroup" id="deleteForm_@group.Id" style="display: none;">
        <input type="hidden" name="groupId" value="@group.Id" />
    </form>
}

@section Scripts {
    <script>
        function setGroupId(groupId) {
            document.getElementById('modalGroupId').value = groupId;
        }

        function deleteGroup(groupId, groupName) {
            if (confirm('Удалить группу "' + groupName + '"?')) {
                document.getElementById('deleteForm_' + groupId).submit();
            }
        }
    </script>
}