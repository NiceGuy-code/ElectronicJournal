@page
@model ElectronicJournal.Pages.Teacher.GroupJournalModel
@{
    ViewData["Title"] = "Журнал группы";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-journal-text"></i> Журнал группы</h2>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Выбор группы и месяца -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Выберите группу</label>
                <select name="selectedGroupId" asp-items="Model.GroupsSelectList" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Выберите группу --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Месяц</label>
                <input type="month" name="month" class="form-control"
                       value="@($"{Model.CurrentMonth.Year}-{Model.CurrentMonth.Month:D2}")"
                       onchange="this.form.submit()" />
            </div>
        </form>
    </div>
</div>

<!-- Журнал -->
@if (Model.SelectedGroupId != 0 && Model.Students.Any() && Model.Lessons.Any())
{
    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th style="min-width: 150px;">Студент</th>
                            @foreach (var lesson in Model.Lessons)
                            {
                                <th class="text-center" style="min-width: 120px;">
                                    <div>@lesson.Date.ToString("dd.MM")</div>
                                    <small class="text-muted">@lesson.Topic</small>
                                </th>
                            }
                        </tr>
                        <tr>
                            <th></th>
                            @foreach (var lesson in Model.Lessons)
                            {
                                <th class="text-center">
                                    <small>Занятие | ДЗ | Посещ.</small>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>
                                    <strong>@student.User?.FullName</strong>
                                </td>
                                @foreach (var lesson in Model.Lessons)
                                {
                                    <td class="text-center">
                                        @{
                                            var grade = Model.Grades.ContainsKey(student.Id) &&
                                            Model.Grades[student.Id].ContainsKey(lesson.Id)
                                            ? Model.Grades[student.Id][lesson.Id]
                                            : null;

                                            var isPresent = Model.Attendance.ContainsKey(student.Id) &&
                                            Model.Attendance[student.Id].ContainsKey(lesson.Id) &&
                                            Model.Attendance[student.Id][lesson.Id];
                                        }

                                        <div class="d-flex gap-2 justify-content-center">
                                            <!-- Оценка за занятие -->
                                            <span class="badge @(grade?.IsNotCertified == true ? "bg-danger" : "bg-primary")" style="min-width: 25px;">
                                                @if (grade?.IsNotCertified == true)
                                                {
                                                    <span>н/а</span>
                                                }
                                                else
                                                {
                                                    @(grade?.LessonGrade?.ToString() ?? "-")
                                                }
                                            </span>

                                            <!-- Оценка за ДЗ -->
                                            <span class="badge bg-info" style="min-width: 25px;">
                                                @(grade?.HomeworkGrade?.ToString() ?? "-")
                                            </span>

                                            <!-- Посещаемость -->
                                            <span class="badge @(isPresent ? "bg-success" : "bg-danger")" style="min-width: 25px;">
                                                @(isPresent ? "✓" : "✗")
                                            </span>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Кнопка скачивания ZIP -->
    <div class="mt-3">
        <h5>Скачать все работы:</h5>
        @foreach (var lesson in Model.Lessons)
        {
            <a asp-controller="File" asp-action="DownloadSubmissions" asp-route-lessonId="@lesson.Id"
               class="btn btn-outline-primary btn-sm me-2 mb-2">
                <i class="bi bi-download"></i> @lesson.Date.ToString("dd.MM") - @lesson.Topic
            </a>
        }
    </div>
}
else if (Model.SelectedGroupId != 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Нет данных для отображения журнала.
    </div>
}