@page "{month?}/{year?}"
@model ElectronicJournal.Pages.Student.GradesModel
@{
    ViewData["Title"] = "Мои оценки";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-star-fill"></i> Мои оценки</h2>
        @if (Model.CurrentStudent?.Group != null)
        {
            <p class="text-muted">Группа: @Model.CurrentStudent.Group.Name</p>
        }
    </div>
</div>

<!-- Навигация по месяцам -->
<div class="card shadow mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-page="./Grades"
               asp-route-month="@Model.PreviousMonth.Month"
               asp-route-year="@Model.PreviousMonth.Year"
               class="btn btn-outline-primary">
                <i class="bi bi-chevron-left"></i> @Model.PreviousMonth.ToString("MMMM yyyy")
            </a>

            <h3 class="mb-0 text-primary">@Model.CurrentMonth.ToString("MMMM yyyy")</h3>

            <a asp-page="./Grades"
               asp-route-month="@Model.NextMonth.Month"
               asp-route-year="@Model.NextMonth.Year"
               class="btn btn-outline-primary">
                @Model.NextMonth.ToString("MMMM yyyy") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Таблица оценок -->
<div class="card shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width: 100px;">Дата</th>
                        <th>Тема занятия</th>
                        <th style="width: 100px;">Преподаватель</th>
                        <th style="width: 100px;">Оценка за занятие</th>
                        <th style="width: 100px;">Оценка за ДЗ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in Model.Lessons)
                    {
                        var lessonGrade = Model.GetLessonGradeDisplay(lesson.Id);
                        var homeworkGrade = Model.GetHomeworkGradeDisplay(lesson.Id);

                        <tr>
                            <td>@lesson.Date.ToString("dd.MM.yyyy")</td>
                            <td>
                                <strong>@lesson.Topic</strong>
                                @if (!string.IsNullOrEmpty(lesson.Description))
                                {
                                    <br />
                                    <small class="text-muted">@lesson.Description</small>
                                }
                            </td>
                            <td>
                                <small>@lesson.Teacher?.User?.FullName</small>
                            </td>
                            <td class="text-center">
                                <span class="@Model.GetGradeClass(lessonGrade) fs-5">
                                    @lessonGrade
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="@Model.GetGradeClass(homeworkGrade) fs-5">
                                    @homeworkGrade
                                </span>
                            </td>
                        </tr>
                    }

                    @if (!Model.Lessons.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                <i class="bi bi-info-circle"></i> Занятий в этом месяце не найдено
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Легенда -->
<div class="card mt-3 shadow">
    <div class="card-body">
        <h6 class="fw-bold mb-3">Обозначения:</h6>
        <div class="row">
            <div class="col-md-6">
                <ul class="list-unstyled">
                    <li class="mb-1"><span class="grade-5">5</span> - Отлично</li>
                    <li class="mb-1"><span class="grade-4">4</span> - Хорошо</li>
                    <li class="mb-1"><span class="grade-3">3</span> - Удовлетворительно</li>
                    <li class="mb-1"><span class="grade-2">2</span> - Неудовлетворительно</li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="list-unstyled">
                    <li class="mb-1"><span class="grade-nb">н/б</span> - Не был на занятии</li>
                    <li class="mb-1"><span class="grade-nk">н/а</span> - Не аттестован</li>
                    <li class="mb-1">-</li> - Нет оценки</li>
                    <li class="mb-1">нет</li> - ДЗ не сдано</li>
                </ul>
            </div>
        </div>
    </div>
</div>