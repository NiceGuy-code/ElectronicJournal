@page
@model ElectronicJournal.Pages.Account.AnnouncementsModel
@{
    ViewData["Title"] = "Объявления";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-megaphone-fill"></i> Объявления</h2>
    </div>
</div>

@if (Model.Announcements.Any())
{
    @foreach (var announcement in Model.Announcements)
    {
        <div class="card shadow mb-3 @(announcement.IsForAll ? "border-info" : "border-success")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h4 class="mb-1">@announcement.Title</h4>
                        <div class="text-muted small">
                            <i class="bi bi-person"></i> @announcement.Author?.FullName
                            <span class="ms-3">
                                <i class="bi bi-clock"></i> @announcement.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </span>
                            @if (announcement.IsForAll)
                            {
                                <span class="ms-3 badge bg-info">
                                    <i class="bi bi-globe"></i> Для всех
                                </span>
                            }
                            else if (announcement.Group != null)
                            {
                                <span class="ms-3 badge bg-success">
                                    <i class="bi bi-people"></i> @announcement.Group.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-2">
                    <p class="mb-0" style="white-space: pre-line;">@announcement.Content</p>
                </div>
            </div>
        </div>
    }

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="./Announcements" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Объявлений пока нет.
    </div>
}